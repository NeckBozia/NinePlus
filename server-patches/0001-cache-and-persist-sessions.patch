+    # Sessions used to live only in memory, so every restart logged everyone
+    # out at once — and the iOS client has no 401 recovery path at all, it just
+    # shows errors until you re-bind by hand. Only the token → account mapping
+    # is stored; the account record is re-read from AccountStore on load, so no
+    # password material is duplicated into this file.
+    def _load_sessions(self) -> None:
+        try:
+            payload = json.loads(self._sessions_path.read_text("utf-8"))
+        except (OSError, ValueError):
+            return
+        tokens = payload.get("sessions", {}) if isinstance(payload, dict) else {}
+        if not isinstance(tokens, dict):
+            return
+        restored = 0
+        with self._session_lock:
+            for token, account in tokens.items():
+                record = self.account_store.record_for(str(account))
+                if record:
+                    self._sessions[str(token)] = (str(account), record)
+                    restored += 1
+        if restored:
+            print(f"restored {restored} app session(s) from {self._sessions_path}")
+
+    def _save_sessions(self) -> None:
+        with self._session_lock:
+            tokens = {token: account for token, (account, _) in self._sessions.items()}
+        temporary = self._sessions_path.with_suffix(".tmp")
+        try:
+            self._sessions_path.parent.mkdir(parents=True, exist_ok=True)
+            with open(temporary, "w", encoding="utf-8") as handle:
+                json.dump({"version": 1, "sessions": tokens}, handle)
+            os.chmod(temporary, 0o600)
+            temporary.replace(self._sessions_path)
+        except OSError as exc:
+            print(f"warning: could not persist sessions: {exc}")
 
